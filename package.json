{
  "name": "pi-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5176",
    "dev:api": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "test": "PI_DESKTOP_LOCALE=zh node --test \"tests/**/*.test.ts\"",
    "bridge:build": "node scripts/build-bridge-runtime.mjs",
    "bridge:sync": "node scripts/build-bridge-runtime.mjs --skip-install",
    "sidecar:verify": "node scripts/verify-sidecar-extensions.mjs",
    "python:build": "node scripts/build-python-runtime.mjs",
    "node:build": "node scripts/build-node-runtime.mjs",
    "icon:build": "node scripts/build-app-icon.mjs",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:prepare": "node scripts/pack.mjs --prepare-only",
    "electron:dev": "node scripts/dev-electron.mjs",
    "pack:electron:mac:arm64": "node scripts/pack.mjs --host electron --target mac --arch arm64",
    "pack:electron:mac:x64": "node scripts/pack.mjs --host electron --target mac --arch x64",
    "pack:electron:mac:arm64:slim": "node scripts/pack.mjs --host electron --target mac --arch arm64 --mode slim",
    "pack:electron:mac:x64:slim": "node scripts/pack.mjs --host electron --target mac --arch x64 --mode slim",
    "pack:tauri:mac:arm64": "node scripts/pack.mjs --host tauri --target mac --arch arm64",
    "pack:tauri:mac:x64": "node scripts/pack.mjs --host tauri --target mac --arch x64",
    "pack:tauri:mac:arm64:slim": "node scripts/pack.mjs --host tauri --target mac --arch arm64 --mode slim",
    "pack:tauri:mac:x64:slim": "node scripts/pack.mjs --host tauri --target mac --arch x64 --mode slim",
    "pack:electron:windows": "node scripts/pack.mjs --host electron --target windows",
    "pack:electron:windows:slim": "node scripts/pack.mjs --host electron --target windows --mode slim",
    "pack:tauri:windows": "node scripts/pack.mjs --host tauri --target windows",
    "pack:tauri:windows:slim": "node scripts/pack.mjs --host tauri --target windows --mode slim"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.17",
    "@assistant-ui/react-markdown": "^0.14.13",
    "@earendil-works/pi-agent-core": "^0.87.0",
    "@earendil-works/pi-ai": "^0.87.0",
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@earendil-works/pi-tui": "^0.87.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.536.0",
    "pi-mcp-adapter": "^2.26.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-shimmer": "^0.4.12",
    "typebox": "1.3.27",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.0"
  }
}
