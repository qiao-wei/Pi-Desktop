{
  "name": "pi-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5176",
    "dev:api": "bun server/index.mjs",
    "build": "tsc -b && vite build",
    "test": "PI_DESKTOP_LOCALE=zh node --test \"tests/**/*.test.ts\"",
    "bridge:build": "node scripts/build-bridge-runtime.mjs",
    "sidecar:verify": "node scripts/verify-sidecar-extensions.mjs",
    "python:build": "node scripts/build-python-runtime.mjs",
    "node:build": "node scripts/build-node-runtime.mjs",
    "icon:build": "node scripts/build-app-icon.mjs",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "electron:dev": "node scripts/dev-electron.mjs",
    "electron:build": "npm run build && npm run python:build && npm run node:build && npm run bridge:build && npm run sidecar:verify && npm run bridge:sync && electron-builder --config src-electron/electron-builder.config.cjs",
    "electron:build:slim": "npm run build && npm run bridge:build && npm run sidecar:verify:slim && npm run bridge:sync && npm run electron:pack:slim",
    "sidecar:verify:slim": "PI_DESKTOP_RUNTIME_MODE=system node scripts/verify-sidecar-extensions.mjs",
    "electron:pack:slim": "PI_DESKTOP_RUNTIME_MODE=system electron-builder --config src-electron/electron-builder.config.cjs",
    "package:mac": "tauri build --bundles app,dmg",
    "package:mac:slim": "tauri build --config src-tauri/tauri.slim.conf.json --bundles app,dmg",
    "package:windows": "tauri build --bundles nsis",
    "package:windows:slim": "tauri build --config src-tauri/tauri.slim.conf.json --bundles nsis",
    "package:windows:cross": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis",
    "package:windows:cross:slim": "tauri build --config src-tauri/tauri.slim.conf.json --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis",
    "bridge:sync": "node scripts/build-bridge-runtime.mjs --skip-install"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.17",
    "@assistant-ui/react-markdown": "^0.14.13",
    "@earendil-works/pi-agent-core": "^0.87.0",
    "@earendil-works/pi-ai": "^0.87.0",
    "@earendil-works/pi-coding-agent": "^0.87.0",
    "@earendil-works/pi-tui": "^0.87.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.536.0",
    "pi-mcp-adapter": "^2.26.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-shimmer": "^0.4.12",
    "typebox": "1.3.27",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.0"
  }
}
