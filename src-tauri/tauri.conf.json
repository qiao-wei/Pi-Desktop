{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Desktop",
  "version": "0.1.0",
  "identifier": "com.pi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5176",
    "beforeBuildCommand": "npm run build && npm run python:build && npm run node:build && npm run bridge:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../skills": "skills",
      "../capabilities.defaults.json": "capabilities.defaults.json",
      "binaries/pi-desktop-server": "pi-desktop-server",
      "binaries/python-runtime": "python-runtime",
      "binaries/node-runtime": "node-runtime",
      "binaries/bridge": "bridge"
    },
    "targets": "all"
  }
}
